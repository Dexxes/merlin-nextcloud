<?xml version="1.0" encoding="UTF-8"?>
<!--
  Merlin Content-Filter: heise.de

  Verfügbare Sektionen:
    <pre-filter>   – Regeln, die auf das rohe HTML VOR dem Readability-Durchlauf angewendet werden
    <post-filter>  – Regeln, die auf den von Readability extrahierten HTML-Content angewendet werden
    <metadata>     – XPath-Regeln zur domain-spezifischen Metadaten-Extraktion (überschreibt Readability)

  Regeltypen (in pre-filter und post-filter):
    <remove id="element-id" />           – Entfernt Elemente mit genau dieser id
    <remove class="teilstring" />        – Entfernt Elemente, deren class diesen Teilstring enthält
    <remove xpath="//div[@data-ad]" />   – Entfernt alle Elemente, die dem XPath entsprechen

  Metadaten-Felder (in <metadata>):
    <title    xpath="..." />   – Seitentitel
    <author   xpath="..." />   – Autorenname
    <excerpt  xpath="..." />   – Teaser / Zusammenfassung
    <image    xpath="..." />   – Bild-URL (bei @content-Attributen: xpath="//meta[...]/@content")
    <published xpath="..." />  – Veröffentlichungsdatum (ISO 8601 oder deutsches Format)
-->
<domain name="heise.de">

  <pre-filter>
    <remove xpath="//div[@class='article-content']/a-collapse[1]" />
    <remove xpath="//*[@type='Preisvergleichinternetservices']" />
    <remove xpath="//div[@data-component='RecommendationBox']" />
    <remove xpath="//a-opt-in" />
    <remove xpath="//div[@class='ad ad--inread']" />
    <remove xpath="//*[@data-component='NewsletterModule']" />
    <remove id="wtma_teaser_ho_vertrieb_inline_branding" />
  </pre-filter>

  <images>
    <caption
        container-xpath="//figure"
        caption-xpath=".//figcaption"
    />
  </images>

  <post-filter>
    <!-- Hier post-Readability-Remove-Regeln eintragen -->
  </post-filter>

  <metadata>
    <!-- Beispiele:
    <title    xpath="//h1[@class='article-title']" />
    <author   xpath="//span[@class='author-name']" />
    <excerpt  xpath="//p[@class='article-intro']" />
    <published xpath="//time[@itemprop='datePublished']/@datetime" />
    -->

    <!--
      og:image zeigt bei heise.de auf eine eigens generierte Social-Crop-
      Rendition (anderer Datei-Hash als das Bild im Artikeltext, z.B.
      "...-0528f3028c5228bb.jpg" vs. "...-dcb760efb2016392.jpeg" für dasselbe
      Foto) - imagesMatchForDedup() kann die beiden URLs deshalb nicht als
      "gleiches Bild" erkennen, wodurch die per <images><caption> oben
      extrahierte Caption nie dem Hero-Bild zugeordnet wird (siehe z.B.
      https://www.heise.de/news/Ueberwachung-ohne-Staatstrojaner-...).
      Hier wird daher direkt die src des Artikel-Hero-Bilds selbst als
      imageUrl übernommen (überschreibt og:image, siehe Step 9 in
      ContentExtractorService::extract()) - identisch zur vom
      <images><caption>-Container gelieferten URL, damit der Dedup-Abgleich
      exakt matcht.
    -->
    <image xpath="//a-lightbox[contains(@class,'article-image')]//a-img/@src" />
  </metadata>

</domain>
