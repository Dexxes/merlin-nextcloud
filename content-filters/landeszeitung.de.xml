<?xml version="1.0" encoding="UTF-8"?>

<domain name="landeszeitung.de">

  <pre-filter>
    <remove xpath="//article//header" />
    <remove xpath="//div[contains(@class, 'ArticleHeadstyled__ArticleTeaserContainer')]" /> <!--Header-->
    <remove xpath="//div[contains(@class, 'Adstyled__AdWrapper')]" /> <!--Werbung-->
  </pre-filter>

  <images>
  </images>


  <post-filter>
  </post-filter>

  <metadata>
  </metadata>

  <paywall>
    <marker xpath="//div[contains(@class,'paywalledContent')]" />
    <subscribe url="https://www.landeszeitung.de/+" />
  </paywall>

</domain>
