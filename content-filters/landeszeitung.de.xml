<?xml version="1.0" encoding="UTF-8"?>

<domain name="landeszeitung.de">

  <pre-filter>
    <remove xpath="//article//header" />
    <remove xpath="//div[contains(@class, 'ArticleHeadstyled__ArticleTeaserContainer')]" /> <!--Header-->
    <remove xpath="//div[contains(@class, 'Adstyled__AdWrapper')]" /> <!--Werbung-->
  </pre-filter>

  <images>
  </images>


  <post-filter>
  </post-filter>

  <metadata>
    <!-- og:image zeigt auf ein separat zugeschnittenes, wasserzeichenversehenes
         Social-Share-Bild (assets.rndtech.de/.../watermark-plus.png) mit einer
         völlig anderen Resizer-Asset-ID als das echte Bild im Artikeltext -
         kein Renditions-Unterschied (der von imagesMatchForDedup() aufgelöst
         würde), sondern ein anderes Asset. Dadurch fand die Hero-Bild-Caption
         nie ihr Bild wieder. Stattdessen das echte Artikelbild (mit Caption)
         verwenden. -->
    <image xpath="(//figure[@data-testid='article-header-image']//img)[1]/@src" />
  </metadata>

  <paywall>
    <marker xpath="//div[contains(@class,'paywalledContent')]" />
    <subscribe url="https://www.landeszeitung.de/+" />
  </paywall>

</domain>
