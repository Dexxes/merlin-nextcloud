<?xml version="1.0" encoding="UTF-8"?>

<domain name="landeszeitung.de">

  <pre-filter>
    <remove xpath="//article//header" />
    <remove xpath="//div[contains(@class, 'ArticleHeadstyled__ArticleTeaserContainer')]" /> <!--Header-->
    <remove xpath="//div[contains(@class, 'Adstyled__AdWrapper')]" /> <!--Werbung-->
  </pre-filter>

  <!-- Jedes Bild (Hero UND Content) steckt in <figure data-testid="article-header-image">
       mit mehrfach verschachtelten Wrapper-<div>s zwischen <figure> und <img> (React-
       Fullscreen-Viewer-Markup) sowie einer <figcaption> mit zwei getrennten <div>s
       (Bildtext + Quelle). Ohne diese Regel verwirft Readability die <figcaption>
       komplett - die Wrapper-Divs allein reichen ihr nicht, um die Figure als
       Artikel-Content zu erkennen. Betrifft auch das Hero-Bild im <header>: das wird
       von <pre-filter><remove xpath="//article//header"> entfernt, bevor Readability
       läuft - die automatische Hoist-Logik in normalizeImageCaptions() zieht die
       Figure vorher aus dem <header> heraus, sonst ginge Bild UND Caption verloren. -->
  <images>
    <caption
      container-xpath="//figure[@data-testid='article-header-image']"
      caption-xpath=".//div[contains(@class,'ImageFooterstyled__Caption')] | .//div[contains(@class,'ImageFooterstyled__Copyright')]"
    />
  </images>


  <post-filter>
  </post-filter>

  <metadata>
  </metadata>

  <paywall>
    <marker xpath="//div[contains(@class,'paywalledContent')]" />
    <subscribe url="https://www.landeszeitung.de/+" />
  </paywall>

</domain>
