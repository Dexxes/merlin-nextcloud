<?xml version="1.0" encoding="UTF-8"?>
<!--
  Merlin Content-Filter: zeit.de

  Verfügbare Sektionen:
    <pre-filter>   – Regeln, die auf das rohe HTML VOR dem Readability-Durchlauf angewendet werden
    <post-filter>  – Regeln, die auf den von Readability extrahierten HTML-Content angewendet werden
    <metadata>     – XPath-Regeln zur domain-spezifischen Metadaten-Extraktion (überschreibt Readability)

  Regeltypen (in pre-filter und post-filter):
    <remove id="element-id" />           – Entfernt Elemente mit genau dieser id
    <remove class="teilstring" />        – Entfernt Elemente, deren class diesen Teilstring enthält
    <remove xpath="//div[@data-ad]" />   – Entfernt alle Elemente, die dem XPath entsprechen

  Metadaten-Felder (in <metadata>):
    <title    xpath="..." />   – Seitentitel
    <author   xpath="..." />   – Autorenname
    <excerpt  xpath="..." />   – Teaser / Zusammenfassung
    <image    xpath="..." />   – Bild-URL (bei @content-Attributen: xpath="//meta[...]/@content")
    <published xpath="..." />  – Veröffentlichungsdatum (ISO 8601 oder deutsches Format)
-->
<domain name="zeit.de">

  <pre-filter>
    <remove xpath="//div[@class='audio-player js-audio-player']" />
    <remove xpath="//header[@class='article-header']" />
    <remove xpath="//header" />
    <remove xpath="//p[@class='symbols']" />
  </pre-filter>

  <!-- Das Aufmacherbild steht bei zeit.de im <header class="article-header">,
       den der Pre-Filter oben komplett entfernt. normalizeImageCaptions()
       läuft vorher und zieht die Figure per Hoist-Logik aus dem <header>
       heraus, sonst gingen Bild UND Caption verloren (wie landeszeitung.de).
       Zwei Kopf-Layouts:
       - Standard: <figure class="article__media"> mit <figcaption>
       - Fullwidth (z. B. Feuilleton): <picture> ohne <figure>, die Caption
         steht in einem Geschwister-<div class="header-fullwidth__caption">. -->
  <images>
    <caption
      container-xpath="//header[contains(@class,'article-header')]//figure[contains(@class,'article__media')]"
      caption-xpath=".//span[contains(@class,'figure__text')]"
      credits-xpath=".//span[contains(@class,'figure__copyright')]"
    />
    <caption
      container-xpath="//div[contains(@class,'header-fullwidth__container')]"
      caption-xpath=".//div[contains(@class,'header-fullwidth__caption')]//span[contains(@class,'figure__text')]"
      credits-xpath=".//div[contains(@class,'header-fullwidth__caption')]//span[contains(@class,'figure__copyright')]"
    />
  </images>

  <post-filter>
    <!-- Hier post-Readability-Remove-Regeln eintragen -->
  </post-filter>

  <images>
    <caption
      container-xpath="//div[@class='header-fullwidth__container']"
      caption-xpath=".//div[@class='figure__caption']/text()"
    />
  </images>

  <metadata>
    <author   xpath="//a[@rel='author']/span" />
    <!-- Beispiele:
    <title    xpath="//h1[@class='article-title']" />
    <author   xpath="//span[@class='author-name']" />
    <excerpt  xpath="//p[@class='article-intro']" />
    <image    xpath="//meta[@property='og:image']/@content" />
    <published xpath="//time[@itemprop='datePublished']/@datetime" />
    -->
  </metadata>

<paywall>
    <marker xpath="//aside[@id='paywall']" />
    <subscribe url="https://premium.zeit.de/probe-abo" />
  </paywall>

</domain>
