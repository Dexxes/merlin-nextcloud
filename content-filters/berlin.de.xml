<?xml version="1.0" encoding="UTF-8"?>
<!--

  Verfügbare Sektionen:
    <pre-filter>   – Regeln, die auf das rohe HTML VOR dem Readability-Durchlauf angewendet werden
    <post-filter>  – Regeln, die auf den von Readability extrahierten HTML-Content angewendet werden
    <metadata>     – XPath-Regeln zur domain-spezifischen Metadaten-Extraktion (überschreibt Readability)

  Regeltypen (in pre-filter und post-filter):
    <remove id="element-id" />           – Entfernt Elemente mit genau dieser id
    <remove class="teilstring" />        – Entfernt Elemente, deren class diesen Teilstring enthält
    <remove xpath="//div[@data-ad]" />   – Entfernt alle Elemente, die dem XPath entsprechen

  Metadaten-Felder (in <metadata>):
    <title    xpath="..." />   – Seitentitel
    <author   xpath="..." />   – Autorenname
    <excerpt  xpath="..." />   – Teaser / Zusammenfassung
    <image    xpath="..." />   – Bild-URL (bei @content-Attributen: xpath="//meta[...]/@content")
    <published xpath="..." />  – Veröffentlichungsdatum (ISO 8601 oder deutsches Format)
-->
<domain name="berlin.de">

  <pre-filter>
  </pre-filter>

  <post-filter>
    <!-- Hier post-Readability-Remove-Regeln eintragen -->
  </post-filter>

    <images>
    <caption
      container-xpath="//div[@class='image']"
      caption-xpath=".//p[@class='image__caption']"
    />
    </images>

  <metadata>
    <!-- berlin.de setzt og:image als name="", nicht property="" (OpenGraph-Spec) -
         die alte Regel unten matchte deswegen nie und fiel auf den generischen
         og:-Fallback zurück. og:image liefert dort teils http:// statt https:// -
         das wird zentral in normalizeUrl() (ContentExtractorService) auf https://
         hochgestuft, iOS ATS blockiert unverschlüsselte Bild-Loads sonst. -->
    <image    xpath="//meta[@name='og:image']/@content | //meta[@property='og:image']/@content" />
    <image xpath="//div[contains(@class, 'type-teaser')]/img/@src" />

    <!-- Beispiele:
    <title    xpath="//h1[@class='article-title']" />
    <author   xpath="//span[@class='author-name']" />
    <excerpt  xpath="//p[@class='article-intro']" />
    <published xpath="//time[@itemprop='datePublished']/@datetime" />
    -->
  </metadata>

</domain>
