<?xml version="1.0" encoding="UTF-8"?>
<!--
  Merlin Content-Filter: zdf.de
-->
<domain name="zdf.de">

  <category>Video</category>

  <!-- HLS-Stream über ZDFs GraphQL-/PTMD-API; Teaser und Beschreibung liest der
       Provider selbst aus dem Next.js-Payload (keine <description>-Regel nötig). -->
  <media>
    <source type="zdf" kind="video" />
  </media>

  <pre-filter>
    <remove xpath="//*[contains(@class,'b-navigation')]" />
    <remove xpath="//*[contains(@class,'b-footer')]" />
    <remove xpath="//*[contains(@class,'b-related-content')]" />
  </pre-filter>

  <post-filter />

  <metadata>
    <title     xpath="//meta[@property='og:title']/@content" />
    <excerpt   xpath="//meta[@property='og:description']/@content" />
    <image     xpath="//meta[@property='og:image']/@content" />
  </metadata>

</domain>
