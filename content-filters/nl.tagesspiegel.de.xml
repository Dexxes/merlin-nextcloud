<?xml version="1.0" encoding="UTF-8"?>
<!--
  Merlin Content-Filter: nl.tagesspiegel.de

  Web-Ansicht der Tagesspiegel-Newsletter (z. B. "Checkpoint"), aufgerufen
  über den "Vollversion im Browser öffnen"-Link. Anders als die
  Artikelseiten unter tagesspiegel.de/www.tagesspiegel.de ist das kein
  Artikel-Layout, sondern eine MJML-generierte E-Mail: eine Abfolge von
  <div class="mobile-section">-Blöcken, jeweils in <tr><td> einer äußeren
  Tabelle (die Outlook-spezifische Verdopplung dieser Struktur steckt in
  MSO-Conditional-Comments und wird von DOMDocument ohnehin ignoriert).

  Werbeblöcke bestehen aus genau zwei aufeinanderfolgenden mobile-section-
  Blöcken: zuerst ein reines Label ("Anzeige" in grauer Schrift, kein
  eigenes class/id-Attribut), danach der eigentliche Anzeigen-Inhalt
  (Bild+Text via MailChimp-Klassen "mcnCaptionRight…", ein einfaches Bild
  oder – bei extern eingebuchten Anzeigen – ein komplettes, per
  copy-paste eingebettetes zweites HTML-Dokument). Die Inhaltsstruktur
  variiert also von Anzeige zu Anzeige; stabil ist nur, dass IMMER auf
  das Anzeige-Label der Anzeigen-Container als direktes Folge-Geschwister
  folgt. Deshalb wird hier nicht der Anzeigeninhalt selbst gematcht,
  sondern die Position relativ zum Label.
-->
<domain name="nl.tagesspiegel.de">

  <pre-filter>

    <!-- Das graue "Anzeige"-Label selbst. -->
    <remove xpath="//div[contains(@class,'mobile-section') and .//div[normalize-space(text())='Anzeige']]" />

    <!-- Der direkt darauffolgende mobile-section-Block: der eigentliche
         Anzeigeninhalt, unabhängig von dessen interner Struktur. -->
    <remove xpath="//div[contains(@class,'mobile-section') and .//div[normalize-space(text())='Anzeige']]/following-sibling::div[contains(@class,'mobile-section')][1]" />

  </pre-filter>

</domain>
