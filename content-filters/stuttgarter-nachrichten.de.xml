<?xml version="1.0" encoding="UTF-8"?>

<domain name="stuttgarter-nachrichten.de">

  <pre-filter>
    <remove class="statichtmlbrick" />
    <remove xpath="//div[@class='article-image']/div" />
  </pre-filter>

  <post-filter>
    <!-- Hier post-Readability-Remove-Regeln eintragen -->
  </post-filter>

  <metadata>
    <!-- Beispiele:
    <title    xpath="//h1[@class='article-title']" />
    <author   xpath="//span[@class='author-name']" />
    <excerpt  xpath="//p[@class='article-intro']" />
    <image    xpath="//meta[@property='og:image']/@content" />
    <published xpath="//time[@itemprop='datePublished']/@datetime" />
    -->
  </metadata>

  <paywall>
    <marker xpath="//div[@id='paywall-container']" />
    <marker xpath="//section[@class='u-paywall']" />
    <subscribe url="https://www.stuttgarter-nachrichten.de/produkte/" />
  </paywall>

</domain>
