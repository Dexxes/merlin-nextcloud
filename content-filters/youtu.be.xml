<?xml version="1.0" encoding="UTF-8"?>
<!--
  Merlin Content-Filter: youtu.be (YouTube-Kurzlinks)
-->
<domain name="youtu.be">
  <category>Video</category>

  <!-- Offizieller Embed-Player (youtube-nocookie), die Video-ID kommt aus der URL. -->
  <media>
    <source type="youtube-embed" kind="video" />
    <description xpath="//meta[@name='description']/@content" />
  </media>
  <pre-filter />
  <post-filter />
  <metadata>
    <title   xpath="//meta[@property='og:title']/@content" />
    <excerpt xpath="//meta[@name='description']/@content" />
    <image   xpath="//meta[@property='og:image']/@content" />
  </metadata>
</domain>
