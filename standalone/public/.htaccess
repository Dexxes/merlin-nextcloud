# Die Vue-App (app/js/*.mjs) sind ES-Module; ältere mime.types kennen .mjs nicht.
<IfModule mod_mime.c>
    AddType text/javascript .mjs
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Nicht auf . oder .. anwenden
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Alles andere auf index.php umschreiben
    RewriteRule ^(.*)$ index.php [L]
</IfModule>
