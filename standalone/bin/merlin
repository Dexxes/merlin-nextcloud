#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Kommandozeile des Standalone-Servers.
 *
 *   bin/merlin migrate                                   fehlende Migrationen anwenden
 *   bin/merlin create-admin --username=… --email=… [--password=…]
 *                                                        Admin-Konto anlegen (ohne --password: Abfrage)
 *   bin/merlin extract <url> [--user=<id>] [--content]   Artikel extrahieren wie beim Speichern, Ergebnis als JSON
 *   bin/merlin cron [--force]                            tägliche Aufgaben (Löschfrist), höchstens einmal am Tag
 */

use Merlin\Core\Extraction\ContentExtractorService;
use Merlin\Standalone\App;
use Merlin\Standalone\Cron\DailyJobs;
use Merlin\Standalone\Auth\PasswordHasher;
use Merlin\Standalone\Db\MigrationRunner;
use Merlin\Standalone\Db\UserRepository;

require_once dirname(__DIR__) . '/vendor/autoload.php';

$command = $argv[1] ?? 'help';

try {
	switch ($command) {
		case 'migrate':
			$app = App::fromConfigFile();
			$applied = (new MigrationRunner($app->connection()))->migrate();
			if ($applied === []) {
				fwrite(STDOUT, "Keine neuen Migrationen.\n");
			}
			foreach ($applied as $version) {
				fwrite(STDOUT, "Angewandt: {$version}\n");
			}
			exit(0);

		case 'create-admin':
			// Übernommen aus merlin-standalone-server (tools/create-admin.php, fe8ed23).
			$options = [];
			foreach (array_slice($argv, 2) as $arg) {
				if (preg_match('/^--([a-z]+)=(.*)$/s', $arg, $m)) {
					$options[$m[1]] = $m[2];
				}
			}
			$username = trim((string) ($options['username'] ?? ''));
			$email = trim((string) ($options['email'] ?? ''));
			$password = isset($options['password']) ? (string) $options['password'] : null;
			if ($username === '' || $email === '') {
				fwrite(STDERR, "Aufruf: bin/merlin create-admin --username=<name> --email=<email> [--password=<passwort>]\n");
				exit(1);
			}
			if ($password === null) {
				fwrite(STDOUT, 'Passwort (mind. 8 Zeichen): ');
				$password = trim((string) fgets(STDIN));
			}
			if (strlen($password) < 8) {
				fwrite(STDERR, "Das Passwort muss mindestens 8 Zeichen lang sein.\n");
				exit(1);
			}
			$app = App::fromConfigFile();
			(new MigrationRunner($app->connection()))->migrate();
			$users = $app->get(UserRepository::class);
			if ($users->findByUsername($username) !== null) {
				fwrite(STDERR, "Benutzername '{$username}' ist bereits vergeben.\n");
				exit(1);
			}
			if ($users->findByEmail($email) !== null) {
				fwrite(STDERR, "E-Mail '{$email}' wird bereits verwendet.\n");
				exit(1);
			}
			$user = $users->create($username, $email, $app->get(PasswordHasher::class)->hash($password), 'admin');
			fwrite(STDOUT, "Admin-Konto '{$user['username']}' (ID {$user['id']}) angelegt.\n");
			exit(0);

		case 'extract':
			// Prüfwerkzeug: dieselbe Extraktion wie beim Speichern eines Artikels,
			// mit den Content-Filtern und Adaptern des Servers. Speichert nichts.
			$url = '';
			$userId = null;
			$withContent = false;
			foreach (array_slice($argv, 2) as $arg) {
				if (str_starts_with($arg, '--user=')) {
					$userId = substr($arg, 7);
				} elseif ($arg === '--content') {
					$withContent = true;
				} elseif ($url === '') {
					$url = $arg;
				}
			}
			if ($url === '') {
				fwrite(STDERR, "Aufruf: bin/merlin extract <url> [--user=<id>] [--content]\n");
				exit(1);
			}
			$app = App::fromConfigFile();
			(new MigrationRunner($app->connection()))->migrate();
			$started = microtime(true);
			$result = $app->get(ContentExtractorService::class)->extract($url, null, $userId);
			$content = (string) ($result['content'] ?? '');
			$summary = $result;
			unset($summary['content']);
			foreach ($summary as $key => $value) {
				if ($value instanceof \DateTimeInterface) {
					$summary[$key] = $value->format(DATE_ATOM);
				}
			}
			$summary['contentLength'] = strlen($content);
			$summary['contentStats'] = [
				'paragraphs' => substr_count($content, '<p'),
				'figures' => substr_count($content, '<figure'),
				'images' => substr_count($content, '<img'),
				'captionCredits' => substr_count($content, '<cite'),
				'blockquotes' => substr_count($content, '<blockquote'),
				'quotes' => substr_count($content, 'class="merlin-quote'),
				'heroImage' => substr_count($content, 'merlin-hero-image'),
				'media' => substr_count($content, 'class="merlin-media') + substr_count($content, 'class="merlin-inline-media'),
				'socialPosts' => preg_match_all('/class="merlin-(bluesky|mastodon|tiktok|instagram|x)-/', $content),
			];
			$summary['seconds'] = round(microtime(true) - $started, 2);
			if ($withContent) {
				$summary['content'] = $content;
			}
			fwrite(STDOUT, json_encode($summary, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
			exit(0);

		case 'cron':
			// Für den System-Cron, z. B. stündlich:
			//   0 * * * * php /pfad/zu/standalone/bin/merlin cron
			// Gearbeitet wird höchstens einmal in 24 Stunden (--force: sofort).
			$app = App::fromConfigFile();
			$result = $app->get(DailyJobs::class)->runIfDue(in_array('--force', $argv, true));
			if ($result === null) {
				fwrite(STDOUT, "Nichts fällig (letzter Lauf vor weniger als 24 Stunden).\n");
			} else {
				fwrite(STDOUT, "Löschfrist: {$result['articles']} Artikel, {$result['shares']} abgelaufene Share-Links gelöscht.\n");
			}
			exit(0);

		case 'help':
		case '--help':
		case '-h':
			fwrite(STDOUT, "Aufruf: bin/merlin <befehl>\n\n  migrate        fehlende Migrationen anwenden\n  create-admin   Admin-Konto anlegen (--username, --email, --password)\n  extract        Artikel extrahieren und als JSON ausgeben (<url> [--user=<id>] [--content])\n  cron           tägliche Aufgaben (Löschfrist), höchstens einmal am Tag ([--force])\n");
			exit(0);

		default:
			fwrite(STDERR, "Unbekannter Befehl: {$command} (bin/merlin help)\n");
			exit(1);
	}
} catch (\Throwable $e) {
	fwrite(STDERR, $e->getMessage() . "\n");
	exit(1);
}
